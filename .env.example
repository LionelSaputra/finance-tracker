# Lokasi file database SQLite (di Docker sudah diatur ke /app/data/finance.db)
DATABASE_PATH=./data/finance.db
# Buat dengan: npm run hash-password
APP_PASSWORD_HASH=
# Buat dengan: openssl rand -hex 32
SESSION_SECRET=
# Token untuk aplikasi trading (openssl rand -hex 32). Kosong = API mati.
TRADING_API_TOKEN=
# Opsional: saran AI. Kosong = tombol AI disembunyikan.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
